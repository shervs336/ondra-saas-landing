# Copy to .env.local and fill in. Leave blank to run the waitlist in demo mode.

# Supabase → Project Settings → API Keys
SUPABASE_URL=https://YOUR-PROJECT-REF.supabase.co
# The "publishable" key (sb_publishable_...). On older projects, set SUPABASE_ANON_KEY instead.
SUPABASE_PUBLISHABLE_KEY=

# Resend → API Keys (free tier). Optional: no key = no confirmation email.
RESEND_API_KEY=
# Until you verify a domain, Resend only delivers to your own account email.
RESEND_FROM="Ondra <onboarding@resend.dev>"
